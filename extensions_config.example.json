{
  "middlewares": [],
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "GitHub MCP server for repository operations"
    },
    "openviking": {
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "X-API-Key": "$OPENVIKING_API_KEY"
      },
      "description": "Official OpenViking tools for explicit memory and resource operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": [
          "database",
          "SQL",
          "table",
          "订单",
          "用户"
        ]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": [
              "查库",
              "订单表",
              "指标"
            ]
          }
        }
      }
    },
    "patent-data": {
      "enabled": false,
      "type": "http",
      "url": "https://mcphub.server.starlove.top/patent/mcp",
      "headers": {
        "Authorization": "$DEERFLOW_PATENT_MCP_AUTHORIZATION"
      },
      "description": "Internal cost-governed patent data MCP served centrally by the api-mcp-hub. Enable only after setting a dedicated token and a JSON project budget map."
    },
    "long-running-reports": {
      "enabled": false,
      "type": "http",
      "url": "https://reports.example.com/mcp",
      "description": "Example ordinary MCP background-task contract",
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "task_toolsets": [
        {
          "name": "report-generation",
          "submit_tool": "submit_report",
          "status_tool": "get_report_status",
          "cancel_tool": "cancel_report"
        }
      ]
    }
  },
  "skills": {
    "skill-reviewer": { "enabled": false },
    "skill-creator": { "enabled": false },
    "find-skills": { "enabled": false },
    "claude-to-deerflow": { "enabled": false },
    "bootstrap": { "enabled": false },
    "surprise-me": { "enabled": false },
    "vercel-deploy": { "enabled": false },
    "web-design-guidelines": { "enabled": false },
    "image-generation": { "enabled": false },
    "music-generation": { "enabled": false },
    "podcast-generation": { "enabled": false },
    "video-generation": { "enabled": false },
    "evidence-based-labeling": { "enabled": false },
    "patent-query-composition": { "enabled": false },
    "applicant-tech-patent-retrieval": { "enabled": false },
    "technology-insight-analysis": { "enabled": false },
    "tech-evolution-analysis": { "enabled": false },
    "black-swan-tech-radar": { "enabled": false }
  }
}
