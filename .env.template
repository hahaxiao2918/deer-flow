# =============================================================================
# DeerFlow · 上海电气专用 .env 模板(config-gitea-sync 方案)
# =============================================================================
# 用法:cp .env.template .env,再填入实际值。
#
# 约定(见 AGENTS.md「Secrets and runtime state」内网私有仓库策略):
#   - .env 永远不入库(.gitignore 已忽略),所有密钥只在这里。
#   - .env.template 入库,仅约束「需要哪些变量」,不含任何真实值。
#   - config.yaml 入库且 dev/prod 共用一份;dev/prod 的差异全部收敛到本文件。
#
# 标注:[必填] 缺失会导致 gateway 启动失败(ValueError)或 deploy.sh 退出;
#       [dev]/[prod] 表示两环境取值不同;留空 = 填真实密钥。
# =============================================================================

# ── 院内 LLM 网关(config.yaml 中所有模型的 api_key 引用此占位)──────────────
# 上海电气内部 OpenAI 兼容网关统一 token。config.yaml 占位 $HUB_EGRESS_TOKEN。[必填]
HUB_EGRESS_TOKEN=
# Kimi Code K3 模型 API key。config.yaml 占位 $KIMI_CODE_API_KEY。[启用 kimi 模型时必填]
KIMI_CODE_API_KEY=

# ── SSO / 三方登录(IPD 数字底座)──────────────────────────────────────────
# 生产走 IPD SSO 时必填;dev 不走 SSO 可留空(AUTH_OIDC_ENABLED=false)。
IPD_CLIENT_ID=
IPD_CLIENT_SECRET=
# better-auth 会话签名密钥。deploy.sh 首次部署自动生成并持久化;脱离 deploy.sh 手动部署时必填。
BETTER_AUTH_SECRET=
# 内部网关多 worker 共享认证 token。deploy.sh 自动生成。
DEER_FLOW_INTERNAL_AUTH_TOKEN=
# ── 本方案新增:把 SSO 开关与回调域名收敛到 env,使 config.yaml dev/prod 真正一份 ──
# 是否启用 OIDC(SSO)登录。 [dev] false   [prod] true
AUTH_OIDC_ENABLED=false
# SSO 回调前端基础 URL。 [dev] http://localhost:13000   [prod] https://<生产域名>
AUTH_FRONTEND_BASE_URL=http://localhost:13000

# ── MCP / 专利检索(extensions_config.json 引用部分占位)─────────────────────
# 以下为专利/MCP 中继授权,extensions_config.json 占位 $DEERFLOW_PATENT_MCP_AUTHORIZATION、
# $MCP_RELAY_AUTHORIZATION。其余为专利 MCP 子系统配置(按实际部署填)。
DEERFLOW_PATENT_MCP_AUTHORIZATION=
MCP_RELAY_AUTHORIZATION=
HUB_MCP_AUTHORIZATION=
DEERFLOW_PATENT_MCP_TOKEN=
# 项目预算 JSON 字符串(专利 MCP 配额),按实际填写。
DEERFLOW_PATENT_MCP_PROJECT_BUDGETS_JSON=
ZHIHUIYA_API_KEY=
ZHIHUIYA_BASE_URL=

# ── 搜索工具 ────────────────────────────────────────────────────────────────
SERPER_API_KEY=
INFOQUEST_API_KEY=

# ── 部署路径 / 运行时(deploy.sh 读取,按环境调整)──────────────────────────
# [prod] /home/starl/deerflow   [dev] <仓库根,如 /home/<user>/deerflow>
DEER_FLOW_HOME=/home/starl/deerflow
DEER_FLOW_CONFIG_PATH=/home/starl/deerflow/config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=/home/starl/deerflow/extensions_config.json
DEER_FLOW_REPO_ROOT=/home/starl/deerflow
# 前端 SSR 回连 gateway。容器内通常 http://gateway:8001;本地 make dev 用 http://localhost:8001。
DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://gateway:8001
# 浏览器可信来源(逗号分隔)。 [prod] https://<生产域名>
DEER_FLOW_TRUSTED_ORIGINS=
# 门户分析导出 token(如启用 portal analytics)。
DEER_FLOW_PORTAL_ANALYTICS_TOKEN=

# ── 网络(绕过企业代理访问内网网关)─────────────────────────────────────────
# 内网网关不走企业代理;逗号分隔的后缀匹配。
no_proxy=localhost,127.0.0.1,.starlove.top,.shanghai-electric.com
NO_PROXY=localhost,127.0.0.1,.starlove.top,.shanghai-electric.com
